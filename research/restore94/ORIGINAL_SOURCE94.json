      {
        "line": 181,
        "text": "    def compute_coherence(self, visits: torch.Tensor) -> torch.Tensor:"
      },
      {
        "line": 182,
        "text": "        \"\"\""
      },
      {
        "line": 183,
        "text": "        Compute coherence measure (Shannon entropy)."
      },
      {
        "line": 184,
        "text": "        "
      },
      {
        "line": 185,
        "text": "        Args:"
      },
      {
        "line": 186,
        "text": "            visits: Visit count distribution"
      },
      {
        "line": 187,
        "text": "            "
      },
      {
        "line": 188,
        "text": "        Returns:"
      },
      {
        "line": 189,
        "text": "            Coherence value"
      },
      {
        "line": 190,
        "text": "        \"\"\""
      },
      {
        "line": 191,
        "text": "        # Convert to probabilities"
      },
      {
        "line": 192,
        "text": "        total_visits = visits.sum()"
      },
      {
        "line": 193,
        "text": "        if total_visits == 0:"
      },
      {
        "line": 194,
        "text": "            return torch.tensor(0.0, device=self.device)"
      },
      {
        "line": 195,
        "text": "        "
      },
      {
        "line": 196,
        "text": "        probs = visits / total_visits"
      },
      {
        "line": 197,
        "text": "        "
      },
      {
        "line": 198,
        "text": "        # Remove zeros for log computation"
      },
      {
        "line": 199,
        "text": "        probs_nonzero = probs[probs > 0]"
      },
      {
        "line": 200,
        "text": "        "
      },
      {
        "line": 201,
        "text": "        # Shannon entropy"
      },
      {
        "line": 202,
        "text": "        coherence = -torch.sum(probs_nonzero * torch.log(probs_nonzero))"
      },
      {
        "line": 203,
        "text": "        "
      },
      {
        "line": 204,
        "text": "        return coherence"
      },
      {
        "line": 205,
        "text": "    "
      },
      {
        "line": 206,
        "text": "    def compute_purity(self, visits: torch.Tensor) -> torch.Tensor:"
      },
      {
        "line": 207,
        "text": "        \"\"\""
      },
      {
        "line": 208,
        "text": "        Compute purity (inverse participation ratio)."
      },
      {
        "line": 209,
        "text": "        "
      },
      {
        "line": 210,
        "text": "        Args:"
      },
      {
        "line": 211,
        "text": "            visits: Visit count distribution"
      },
      {
        "line": 212,
        "text": "            "
      },
      {
        "line": 213,
        "text": "        Returns:"
      },
      {
        "line": 214,
        "text": "            Purity value"
      },
      {
        "line": 215,
        "text": "        \"\"\""
      },
      {
        "line": 216,
        "text": "        # Convert to probabilities"
      },
      {
        "line": 217,
        "text": "        total_visits = visits.sum()"
      },
      {
        "line": 218,
        "text": "        if total_visits == 0:"
      },
      {
        "line": 219,
        "text": "            return torch.tensor(1.0, device=self.device)"
      },
      {
        "line": 220,
        "text": "        "
      },
      {
        "line": 221,
        "text": "        probs = visits / total_visits"
      },
      {
        "line": 222,
        "text": "        "
      },
      {
        "line": 223,
        "text": "        # Purity is sum of squared probabilities"
      },
      {
        "line": 224,
        "text": "        purity = torch.sum(probs ** 2)"
      },
      {
        "line": 225,
        "text": "        "
      },
      {
        "line": 226,
        "text": "        return purity"
      },
      {
        "line": 227,
        "text": "    "
      },
      {
        "line": 357,
        "text": "    def identify_pointer_states(self, snapshot) -> List[Dict[str, Any]]:"
      },
      {
        "line": 358,
        "text": "        \"\"\""
      },
      {
        "line": 359,
        "text": "        Identify pointer states (robust classical outcomes)."
      },
      {
        "line": 360,
        "text": "        "
      },
      {
        "line": 361,
        "text": "        Args:"
      },
      {
        "line": 362,
        "text": "            snapshot: TreeSnapshot object"
      },
      {
        "line": 363,
        "text": "            "
      },
      {
        "line": 364,
        "text": "        Returns:"
      },
      {
        "line": 365,
        "text": "            List of pointer state information"
      },
      {
        "line": 366,
        "text": "        \"\"\""
      },
      {
        "line": 367,
        "text": "        visits = snapshot.observables.get('visit_distribution')"
      },
      {
        "line": 368,
        "text": "        if visits is None:"
      },
      {
        "line": 369,
        "text": "            return []"
      },
      {
        "line": 370,
        "text": "        "
      },
      {
        "line": 371,
        "text": "        # Ensure tensor"
      },
      {
        "line": 372,
        "text": "        if not isinstance(visits, torch.Tensor):"
      },
      {
        "line": 373,
        "text": "            visits = torch.tensor(visits, device=self.device)"
      },
      {
        "line": 374,
        "text": "        else:"
      },
      {
        "line": 375,
        "text": "            visits = visits.to(self.device)"
      },
      {
        "line": 376,
        "text": "        "
      },
      {
        "line": 377,
        "text": "        # Convert to probabilities"
      },
      {
        "line": 378,
        "text": "        total_visits = visits.sum()"
      },
      {
        "line": 379,
        "text": "        if total_visits == 0:"
      },
      {
        "line": 380,
        "text": "            return []"
      },
      {
        "line": 381,
        "text": "        "
      },
      {
        "line": 382,
        "text": "        probs = visits / total_visits"
      },
      {
        "line": 383,
        "text": "        "
      },
      {
        "line": 384,
        "text": "        # Pointer states are high-probability outcomes"
      },
      {
        "line": 385,
        "text": "        # Use threshold of mean + std"
      },
      {
        "line": 386,
        "text": "        threshold = probs.mean() + probs.std()"
      },
      {
        "line": 387,
        "text": "        "
      },
      {
        "line": 388,
        "text": "        pointer_states = []"
      },
      {
        "line": 389,
        "text": "        for idx, prob in enumerate(probs):"
      },
      {
        "line": 390,
        "text": "            if prob > threshold:"
      },
      {
        "line": 391,
        "text": "                pointer_states.append({"
      },
      {
        "line": 392,
        "text": "                    'node_index': int(idx),"
      },
      {
        "line": 393,
        "text": "                    'visit_fraction': float(prob),"
      },
      {
        "line": 394,
        "text": "                    'visits': int(visits[idx])"
      },
      {
        "line": 395,
        "text": "                })"
      },
      {
        "line": 396,
        "text": "        "
      },
      {
        "line": 397,
        "text": "        # Sort by visit fraction"
      },
      {
        "line": 398,
        "text": "        pointer_states.sort(key=lambda x: x['visit_fraction'], reverse=True)"
      },
      {
        "line": 399,
        "text": "        "
      },
      {
        "line": 400,
        "text": "        return pointer_states"
      },
      {
        "line": 401,
        "text": "    "
      },
      {
        "line": 402,
        "text": "    def compute_density_matrix(self, visits: torch.Tensor) -> torch.Tensor:"
      },
      {
        "line": 403,
        "text": "        \"\"\""
      },
      {
        "line": 404,
        "text": "        Compute density matrix from visit distribution."
      },
      {
        "line": 405,
        "text": "        "
      },
      {
        "line": 406,
        "text": "        In path integral formulation:"
      },
      {
        "line": 407,
        "text": "        \u03c1 = |\u03c8\u27e9\u27e8\u03c8| where |\u03c8\u27e9 = \u03a3_i \u221a(p_i) |i\u27e9"
      },
      {
        "line": 408,
        "text": "        "
      },
      {
        "line": 409,
        "text": "        Args:"
      },
      {
        "line": 410,
        "text": "            visits: Visit counts for each action"
      },
      {
        "line": 411,
        "text": "            "
      },
      {
        "line": 412,
        "text": "        Returns:"
      },
      {
        "line": 413,
        "text": "            Density matrix"
      },
      {
        "line": 414,
        "text": "        \"\"\""
      },
      {
        "line": 415,
        "text": "        # Normalize to get probabilities"
      },
      {
        "line": 416,
        "text": "        total_visits = visits.sum()"
      },
      {
        "line": 417,
        "text": "        if total_visits == 0:"
      },
      {
        "line": 418,
        "text": "            n_actions = len(visits)"
      },
      {
        "line": 419,
        "text": "            return torch.eye(n_actions, device=self.device) / n_actions"
      },
      {
        "line": 420,
        "text": "        "
      },
      {
        "line": 421,
        "text": "        # Wavefunction amplitudes"
      },
      {
        "line": 422,
        "text": "        psi = torch.sqrt(visits / total_visits)"
      },
      {
        "line": 423,
        "text": "        "
      },
      {
        "line": 424,
        "text": "        # Density matrix \u03c1 = |\u03c8\u27e9\u27e8\u03c8|"
      },
      {
        "line": 425,
        "text": "        rho = torch.outer(psi, psi)"
      },
      {
        "line": 426,
        "text": "        "
      },
      {
        "line": 427,
        "text": "        return rho"
      },
      {
        "line": 428,
        "text": "    "
      },
      {
        "line": 429,
        "text": "    def compute_coherence_from_density_matrix(self, rho: torch.Tensor) -> torch.Tensor:"
      },
      {
        "line": 430,
        "text": "        \"\"\""
      },
      {
        "line": 431,
        "text": "        Compute coherence from density matrix."
      },
      {
        "line": 432,
        "text": "        "
      },
      {
        "line": 433,
        "text": "        Coherence = sum of absolute values of off-diagonal elements"
      },
      {
        "line": 434,
        "text": "        "
      },
      {
        "line": 435,
        "text": "        Args:"
      },
      {
        "line": 436,
        "text": "            rho: Density matrix"
      },
      {
        "line": 437,
        "text": "            "
      },
      {
        "line": 438,
        "text": "        Returns:"
      },
      {
        "line": 439,
        "text": "            Coherence measure"
      },
      {
        "line": 440,
        "text": "        \"\"\""
      },
      {
        "line": 441,
        "text": "        n = rho.shape[0]"
      },
      {
        "line": 442,
        "text": "        # Get off-diagonal elements"
      },
      {
        "line": 443,
        "text": "        mask = ~torch.eye(n, dtype=torch.bool, device=self.device)"
      },
      {
        "line": 444,
        "text": "        coherence = torch.abs(rho[mask]).sum()"
      },
      {
        "line": 445,
        "text": "        return coherence"
      },
      {
        "line": 446,
        "text": "    "
      },
      {
        "line": 447,
        "text": "    def compute_purity_from_density_matrix(self, rho: torch.Tensor) -> torch.Tensor:"
      },
      {
        "line": 448,
        "text": "        \"\"\""
      },
      {
        "line": 449,
        "text": "        Compute purity from density matrix."
      },
      {
        "line": 450,
        "text": "        "
      },
      {
        "line": 451,
        "text": "        Purity = Tr(\u03c1\u00b2)"
      },
      {
        "line": 452,
        "text": "        - Pure state: P = 1"
      },
      {
        "line": 453,
        "text": "        - Maximally mixed: P = 1/d"
      },
      {
        "line": 454,
        "text": "        "
      },
      {
        "line": 455,
        "text": "        Args:"
      },
      {
        "line": 456,
        "text": "            rho: Density matrix"
      },
      {
        "line": 457,
        "text": "            "
      },
      {
        "line": 458,
        "text": "        Returns:"
      },
      {
        "line": 459,
        "text": "            Purity"
      },
      {
        "line": 460,
        "text": "        \"\"\""
      },
      {
        "line": 461,
        "text": "        rho_squared = torch.matmul(rho, rho)"
      },
      {
        "line": 462,
        "text": "        purity = torch.trace(rho_squared)"
      },
      {
        "line": 463,
        "text": "        return purity"
      },
      {
        "line": 464,
        "text": "    "
      },
      {
        "line": 465,
        "text": "    def compute_von_neumann_entropy(self, rho: torch.Tensor) -> torch.Tensor:"
      },
      {
        "line": 466,
        "text": "        \"\"\""
      },
      {
        "line": 467,
        "text": "        Compute von Neumann entropy."
      },
      {
        "line": 468,
        "text": "        "
      },
      {
        "line": 469,
        "text": "        S = -Tr(\u03c1 log \u03c1)"
      },
      {
        "line": 470,
        "text": "        "
      },
      {
        "line": 471,
        "text": "        Args:"
      },
      {
        "line": 472,
        "text": "            rho: Density matrix"
      },
      {
        "line": 473,
        "text": "            "
      },
      {
        "line": 474,
        "text": "        Returns:"
      },
      {
        "line": 475,
        "text": "            von Neumann entropy"
      },
      {
        "line": 476,
        "text": "        \"\"\""
      },
      {
        "line": 477,
        "text": "        # Eigendecomposition"
      },
      {
        "line": 478,
        "text": "        eigenvalues, _ = torch.linalg.eigh(rho)"
      },
      {
        "line": 479,
        "text": "        "
      },
      {
        "line": 480,
        "text": "        # Filter out zero eigenvalues to avoid log(0)"
      },
      {
        "line": 481,
        "text": "        eigenvalues = eigenvalues[eigenvalues > 1e-10]"
      },
      {
        "line": 482,
        "text": "        "
      },
      {
        "line": 483,
        "text": "        # von Neumann entropy"
      },
      {
        "line": 484,
        "text": "        entropy = -torch.sum(eigenvalues * torch.log(eigenvalues))"
      },
      {
        "line": 485,
        "text": "        "
      },
      {
        "line": 486,
        "text": "        return entropy"
      },
      {
        "line": 487,
        "text": "    "
      }
